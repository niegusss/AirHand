# Development-only engine discovery overrides.
#
# Production uses a dynamic port published in the handshake file, which Tauri's Rust layer reads.
# A browser cannot read that file, so browser development pins the port and token instead.
#
# Copy to .env.local, then start the engine with matching flags:
#   python -m airhand.main --port 8765 --token dev-token
VITE_AIRHAND_WS_URL=ws://127.0.0.1:8765
VITE_AIRHAND_WS_TOKEN=dev-token
